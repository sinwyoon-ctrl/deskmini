#!/bin/bash
# 사용: vault-note <파일명.md> < 내용   또는   vault-note <파일명.md> <내용파일>
# ~/vault-agent 의 00-inbox/agent/ 에만 쓰고 push 한다.
set -u
REPO="$HOME/vault-agent"
DIR="00-inbox/agent"
name="${1:-}"
src="${2:-}"
[ -n "$name" ] || { echo "사용: vault-note <파일명.md> < 내용  또는  vault-note <파일명.md> <내용파일>" >&2; exit 2; }
case "$name" in
  *..*|*/*|.*) echo "거부: 파일명에 '..', '/' 또는 선행 '.' 을 쓸 수 없다." >&2; exit 2;;
esac
case "$name" in *.md) ;; *) echo "거부: 파일명은 .md 로 끝나야 한다." >&2; exit 2;; esac
[ -d "$REPO/.git" ] || { echo "오류: $REPO 가 없다." >&2; exit 1; }
if [ -n "$src" ]; then
  [ -f "$src" ] || { echo "오류: 내용파일 없음: $src" >&2; exit 2; }
  body="$(cat "$src")"
else
  body="$(cat)"
fi
cd "$REPO" || exit 1
git pull --rebase --quiet origin main || { echo "오류: pull --rebase 실패. 수동 확인 필요." >&2; exit 1; }
mkdir -p "$DIR"
target="$DIR/$name"
today="$(date +%F)"
if [ "$(printf '%s\n' "$body" | head -n1)" = "---" ]; then
  printf '%s\n' "$body" > "$target"
else
  title="${name%.md}"
  { printf -- '---\ntitle: %s\ntype: inbox\nupdated: %s\n---\n\n' "$title" "$today"; printf '%s\n' "$body"; } > "$target"
fi
git add -- "$target"
if git diff --cached --quiet; then echo "변경 없음: $target"; exit 0; fi
if ! git commit --quiet -m "agent: $name"; then
  echo "거절: 커밋 단계 비밀 검사에 걸렸다(값은 표시하지 않음). 파일은 $REPO/$target 에 남겨 두었다. 내용을 고친 뒤 다시 실행." >&2
  git reset --quiet 2>/dev/null
  exit 1
fi
try_push() { out="$(git push --quiet origin HEAD:main 2>&1)"; rc=$?; return $rc; }
if try_push; then echo "완료: $target"; exit 0; fi
if printf '%s' "$out" | grep -qiE 'secret|비밀|거절된 push|검토되지 않은'; then
  git reset --soft origin/main
  echo "거절: 서버 비밀 검사에 걸렸다(값은 표시하지 않음). 파일은 $REPO/$target 에 남겨 두었다. 내용을 고친 뒤 다시 실행." >&2
  printf '%s\n' "$out" | grep -v '^$' | head -10 >&2
  exit 1
fi
if printf '%s' "$out" | grep -qiE 'non-fast-forward|fetch first|rejected'; then
  git pull --rebase --quiet origin main || { echo "오류: 재시도 pull --rebase 실패." >&2; exit 1; }
  if try_push; then echo "완료(재시도): $target"; exit 0; fi
fi
echo "실패: push 되지 않았다. 로컬 커밋은 $REPO 에 남아 있다." >&2
printf '%s\n' "$out" | head -10 >&2
exit 1
