#!/bin/bash
# 볼트 백업: DeskMini → 메인 PC D 드라이브(restic, SFTP). 메인이 켜져 있는 낮에만 가능하므로
# cron 이 09~18시 매시 부르고, 하루 한 번 성공하면 그날은 더 하지 않는다.
# 설정: ~/.config/vault-backup/env (RESTIC_REPOSITORY=sftp:<호스트>:/D:/vault-backup, RESTIC_PASSWORD_FILE, MAIN_SSH_HOST)
set -u
ENVF="$HOME/.config/vault-backup/env"; STATE="$HOME/.local/state/vault-backup"; mkdir -p "$STATE"
LOG="$STATE/log"; today=$(date +%F)
log(){ echo "$(date '+%F %T') $*" >> "$LOG"; }
[ -f "$ENVF" ] || { echo "vault-backup: 미설정($ENVF 없음)"; exit 0; }
set -a; . "$ENVF"; set +a
: "${RESTIC_REPOSITORY:?}" "${RESTIC_PASSWORD_FILE:?}" "${MAIN_SSH_HOST:?}"
SSH_OPTS=${VAULT_SSH_OPTS:-"-o BatchMode=yes -o ConnectTimeout=5"}
R=(restic); [ -n "${RESTIC_SFTP_COMMAND:-}" ] && R=(restic -o "sftp.command=$RESTIC_SFTP_COMMAND")
export PATH="$HOME/.local/bin:$PATH"
command -v restic >/dev/null || { log "restic 미설치"; echo "vault-backup: restic 미설치"; exit 1; }
[ "${1:-}" = "--force" ] || { [ "$(cat "$STATE/last-success" 2>/dev/null)" = "$today" ] && exit 0; }
# 메인 켜져 있나(5초 안에 SSH 응답)
if ! ssh $SSH_OPTS "$MAIN_SSH_HOST" exit 2>/dev/null; then
  log "메인 미응답, 건너뜀"; exit 0
fi
"${R[@]}" snapshots >/dev/null 2>&1 || { "${R[@]}" init >>"$LOG" 2>&1 || { log "init 실패"; exit 1; }; }
paths=("$HOME/vault.git" "$HOME/vault-agent")
[ -f "$HOME/vault/.claude/settings.local.json" ] && paths+=("$HOME/vault/.claude/settings.local.json")
if "${R[@]}" backup --quiet "${paths[@]}" >>"$LOG" 2>&1 && "${R[@]}" forget --quiet --keep-daily 30 --prune >>"$LOG" 2>&1; then
  echo "$today" > "$STATE/last-success"; log "성공"
else
  log "백업 실패"
  # 이틀 연속 성공 없으면 알림
  last=$(cat "$STATE/last-success" 2>/dev/null || echo 1970-01-01)
  if [ $(( ( $(date -d "$today" +%s) - $(date -d "$last" +%s) ) / 86400 )) -ge 2 ]; then
    "$HOME/bin/notify" "볼트 백업: 2일 이상 성공 없음(메인 D 드라이브). 로그 ~/.local/state/vault-backup/log" 2>/dev/null
  fi
  exit 1
fi
