#!/bin/bash
# push 를 받으면 읽기 전용 거울 ~/vault 를 fast-forward 만 한다(그래프 실행 없음).
LOG="$HOME/.local/state/vault-sync.log"; mkdir -p "$(dirname "$LOG")"
{
  echo "=== $(date '+%F %T') push 수신"
  unset GIT_DIR GIT_WORK_TREE
  if git -C "$HOME/vault" pull --ff-only --quiet origin main 2>&1; then
    echo "거울 갱신: $(git -C "$HOME/vault" rev-parse --short HEAD)"
  else
    echo "거울 갱신 실패(ff-only) — 수동 확인 필요"
    "$HOME/bin/notify" "볼트: push 는 받았지만 ~/vault 거울 ff 갱신 실패. 수동 확인 필요" 2>/dev/null
  fi
} >>"$LOG" 2>&1
